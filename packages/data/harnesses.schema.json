{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/auron-labs/harness-detect/packages/data/harnesses.schema.json",
  "title": "Harness registry",
  "description": "Schema for the harness-detect registry (packages/data/harnesses.json).",
  "type": "object",
  "required": ["version", "harnesses"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "description": "Registry schema version. Additive harness metadata such as installations[] remains version 1; bump only for incompatible registry shape changes.",
      "type": "integer",
      "enum": [1]
    },
    "harnesses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "key",
          "name",
          "aliases",
          "executables",
          "paths",
          "env",
          "sources",
          "support",
          "installations",
          "version",
          "mcp"
        ],
        "additionalProperties": false,
        "anyOf": [
          {
            "properties": { "executables": { "type": "array", "minItems": 1 } }
          },
          { "properties": { "paths": { "type": "array", "minItems": 1 } } },
          {
            "description": "An ACP launch record may lack portable detection signals; notes must explain its setup requirements.",
            "required": ["acp"],
            "properties": {
              "acp": {
                "type": "object",
                "required": ["status", "launches", "notes"],
                "properties": { "status": { "const": "supported" } }
              }
            }
          }
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "description": "Upstream product version the entry's data was last verified against (for example \"0.169.0\"), or \"unknown\" when upstream publishes no version. Descriptive only; never compared at runtime.",
            "type": "string",
            "pattern": "^\\S+$"
          },
          "aliases": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "\\S" }
          },
          "executables": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "\\S" }
          },
          "paths": {
            "type": "array",
            "items": { "$ref": "#/$defs/HarnessPathSpec" }
          },
          "roots": {
            "type": "array",
            "items": { "$ref": "#/$defs/HarnessRootDef" }
          },
          "env": {
            "type": "array",
            "items": { "$ref": "#/$defs/HarnessEnvVar" }
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/HttpsUrl" }
          },
          "acp": {
            "description": "Describes platform-scoped local stdio launches or a direct adapter registry key; never detection evidence. Omitted metadata is unknown.",
            "$ref": "#/$defs/HarnessAcp"
          },
          "mcp": {
            "description": "Required descriptive MCP (Model Context Protocol) client metadata: whether the harness can use MCP servers, whether it reads the project-root .mcp.json, where it stores MCP servers per scope, and how .mcp.json servers translate into its native config. Never detection evidence.",
            "$ref": "#/$defs/HarnessMcp"
          },
          "support": {
            "description": "Required descriptive support metadata. All support categories and both scopes must be populated explicitly for every harness; use status/confidence 'unknown' rather than omitting unsupported or unknown data.",
            "$ref": "#/$defs/HarnessSupport"
          },
          "installations": {
            "description": "Descriptive install metadata only. This additive field does not change registry version 1 and is not detection evidence.",
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/HarnessInstallation" }
          }
        }
      }
    }
  },
  "$defs": {
    "HarnessMcp": {
      "type": "object",
      "required": ["status", "mcpJson", "global", "local", "sources", "confidence"],
      "additionalProperties": false,
      "properties": {
        "status": {
          "description": "Whether the harness acts as an MCP client that can be configured with MCP servers.",
          "enum": ["supported", "unsupported", "unknown"]
        },
        "mcpJson": {
          "description": "Whether the harness natively reads the project-root .mcp.json file ({\"mcpServers\": {...}}).",
          "enum": ["supported", "unsupported", "unknown"]
        },
        "global": { "$ref": "#/$defs/HarnessMcpScope" },
        "local": { "$ref": "#/$defs/HarnessMcpScope" },
        "serverFormat": { "$ref": "#/$defs/HarnessMcpServerFormat" },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/HttpsUrl" }
        },
        "confidence": {
          "enum": ["official", "source", "observed", "inferred", "unknown"]
        },
        "notes": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "enum": ["supported", "unsupported"] } }
          },
          "then": {
            "properties": {
              "sources": { "type": "array", "minItems": 1 },
              "confidence": { "not": { "const": "unknown" } }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "supported" } } },
          "else": {
            "properties": {
              "mcpJson": { "not": { "const": "supported" } },
              "global": {
                "type": "object",
                "properties": { "status": { "not": { "const": "supported" } } }
              },
              "local": {
                "type": "object",
                "properties": { "status": { "not": { "const": "supported" } } }
              }
            },
            "not": { "required": ["serverFormat"] }
          }
        }
      ]
    },
    "HarnessMcpScope": {
      "type": "object",
      "required": ["status", "paths", "sources", "confidence"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["supported", "unsupported", "unknown"] },
        "paths": {
          "description": "Config files (or directories of config files) that hold MCP servers for this scope.",
          "type": "array",
          "items": { "$ref": "#/$defs/HarnessSupportPath" }
        },
        "format": {
          "description": "File format of the MCP config files.",
          "enum": ["json", "jsonc", "toml", "yaml"]
        },
        "keyPath": {
          "description": "Key segments under which MCP servers are stored, outermost first. A literal key containing a dot is one segment (for example [\"amp.mcpServers\"]).",
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/HttpsUrl" }
        },
        "confidence": {
          "enum": ["official", "source", "observed", "inferred", "unknown"]
        },
        "notes": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "enum": ["supported", "unsupported"] } }
          },
          "then": {
            "properties": {
              "sources": { "type": "array", "minItems": 1 },
              "confidence": { "not": { "const": "unknown" } }
            }
          }
        },
        {
          "if": {
            "required": ["status", "paths"],
            "properties": {
              "status": { "const": "supported" },
              "paths": { "type": "array", "minItems": 1 }
            }
          },
          "then": { "required": ["format", "keyPath"] },
          "else": {
            "not": { "anyOf": [{ "required": ["format"] }, { "required": ["keyPath"] }] }
          }
        }
      ]
    },
    "HarnessMcpServerFormat": {
      "description": "Describes the native shape of one MCP server entry so .mcp.json servers can be translated without harness-specific code.",
      "type": "object",
      "required": ["container", "stdio"],
      "additionalProperties": false,
      "properties": {
        "container": {
          "description": "map: an object keyed by server name; array: a list of entries that carry the name in nameField.",
          "enum": ["map", "array"]
        },
        "nameField": {
          "description": "Field that stores the server name inside each entry. Required for array containers; optional for maps.",
          "$ref": "#/$defs/McpFieldName"
        },
        "typeField": {
          "description": "Field that names the transport. Transports with a type value write it here.",
          "$ref": "#/$defs/McpFieldName"
        },
        "stdio": {
          "type": "object",
          "required": ["command"],
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string", "minLength": 1 },
            "command": { "$ref": "#/$defs/McpFieldName" },
            "args": {
              "description": "Field for the argument list. When omitted, the command field holds an argv array [command, ...args].",
              "$ref": "#/$defs/McpFieldName"
            },
            "env": {
              "description": "Field for environment variables. When omitted, servers that set env cannot be translated.",
              "$ref": "#/$defs/McpFieldName"
            }
          }
        },
        "http": { "$ref": "#/$defs/HarnessMcpRemoteFormat" },
        "sse": { "$ref": "#/$defs/HarnessMcpRemoteFormat" },
        "defaults": {
          "description": "Static fields added to every translated entry before mapped fields.",
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              { "type": "string" },
              { "type": "number" },
              { "type": "boolean" }
            ]
          }
        }
      },
      "if": { "properties": { "container": { "const": "array" } } },
      "then": { "required": ["nameField"] }
    },
    "HarnessMcpRemoteFormat": {
      "description": "Native shape for a remote transport. Omit the transport when the harness cannot use it.",
      "type": "object",
      "required": ["url"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "url": { "$ref": "#/$defs/McpFieldName" },
        "headers": {
          "description": "Field for HTTP headers. When omitted, servers that set headers cannot be translated.",
          "$ref": "#/$defs/McpFieldName"
        }
      }
    },
    "McpFieldName": {
      "type": "string",
      "minLength": 1
    },
    "HarnessAcp": {
      "type": "object",
      "required": ["status", "sources", "confidence"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["supported", "unsupported", "unknown"] },
        "launches": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/HarnessAcpLaunch" }
        },
        "installedLaunches": {
          "description": "Launches that start the agent from a binary already on PATH. Never a package runner.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/HarnessAcpLaunch" }
        },
        "adapter": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/HttpsUrl" }
        },
        "confidence": {
          "enum": ["official", "source", "observed", "inferred", "unknown"]
        },
        "notes": { "type": "string", "minLength": 1 }
      },
      "dependentRequired": { "installedLaunches": ["launches"] },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "supported" } } },
          "then": {
            "oneOf": [{ "required": ["launches"] }, { "required": ["adapter"] }]
          },
          "else": {
            "not": {
              "anyOf": [{ "required": ["launches"] }, { "required": ["adapter"] }]
            }
          }
        },
        {
          "if": {
            "properties": { "status": { "enum": ["supported", "unsupported"] } }
          },
          "then": {
            "properties": {
              "sources": { "type": "array", "minItems": 1 },
              "confidence": { "not": { "const": "unknown" } }
            }
          }
        }
      ]
    },
    "HarnessAcpLaunch": {
      "type": "object",
      "required": ["command", "args"],
      "additionalProperties": false,
      "properties": {
        "command": { "type": "string", "pattern": "\\S" },
        "args": { "type": "array", "items": { "type": "string" } },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/Platform" }
        }
      }
    },
    "Platform": {
      "type": "string",
      "enum": [
        "aix",
        "android",
        "cygwin",
        "darwin",
        "freebsd",
        "haiku",
        "linux",
        "netbsd",
        "openbsd",
        "sunos",
        "win32"
      ]
    },
    "HarnessPathSpec": {
      "type": "object",
      "required": ["id", "category", "kind", "template"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": ["install", "config", "state", "cache", "project"]
        },
        "kind": {
          "enum": ["file", "dir"]
        },
        "template": {
          "type": "string",
          "pattern": "^(?:[^$]|\\$(?!\\{)|\\$\\{[A-Z_][A-Z0-9_]*\\})*$"
        },
        "platforms": {
          "type": "array",
          "items": { "$ref": "#/$defs/Platform" }
        }
      }
    },
    "HarnessInstallation": {
      "type": "object",
      "required": ["method", "url"],
      "additionalProperties": false,
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "npm",
            "homebrew",
            "pip",
            "pipx",
            "uv",
            "cargo",
            "go",
            "script",
            "manual",
            "marketplace",
            "binary",
            "unknown"
          ]
        },
        "package": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "url": { "$ref": "#/$defs/HttpsUrl" },
        "marketplace": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/Platform" }
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "HttpsUrl": {
      "type": "string",
      "pattern": "^https://.+$"
    },
    "HarnessSupport": {
      "type": "object",
      "required": ["config", "skills", "commands", "agents", "agentsSkills"],
      "additionalProperties": false,
      "properties": {
        "config": { "$ref": "#/$defs/HarnessSupportArea" },
        "skills": { "$ref": "#/$defs/HarnessSupportArea" },
        "commands": { "$ref": "#/$defs/HarnessSupportArea" },
        "agents": { "$ref": "#/$defs/HarnessSupportArea" },
        "agentsSkills": {
          "description": "Whether the harness discovers Agent Skills from the shared, vendor-neutral .agents/skills directory (global: ${HOME}/.agents/skills, local: ${CWD}/.agents/skills). Vendor directories such as .claude/skills belong in skills.",
          "$ref": "#/$defs/HarnessSupportArea"
        }
      }
    },
    "HarnessSupportArea": {
      "type": "object",
      "required": ["global", "local"],
      "additionalProperties": false,
      "properties": {
        "global": { "$ref": "#/$defs/HarnessSupportScope" },
        "local": { "$ref": "#/$defs/HarnessSupportScope" }
      }
    },
    "HarnessSupportScope": {
      "type": "object",
      "required": ["status", "paths", "sources", "confidence"],
      "additionalProperties": false,
      "if": {
        "properties": { "status": { "enum": ["supported", "unsupported"] } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "sources": { "type": "array", "minItems": 1 },
          "confidence": { "not": { "const": "unknown" } }
        }
      },
      "properties": {
        "status": {
          "type": "string",
          "enum": ["supported", "unsupported", "unknown"]
        },
        "paths": {
          "type": "array",
          "items": { "$ref": "#/$defs/HarnessSupportPath" }
        },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/HttpsUrl" }
        },
        "confidence": {
          "type": "string",
          "enum": ["official", "source", "observed", "inferred", "unknown"]
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "HarnessSupportPath": {
      "type": "object",
      "required": ["id", "kind", "template"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": ["file", "dir"]
        },
        "template": {
          "type": "string",
          "pattern": "^(?:[^$]|\\$(?!\\{)|\\$\\{[A-Z_][A-Z0-9_]*\\})*$"
        },
        "platforms": {
          "type": "array",
          "items": { "$ref": "#/$defs/Platform" }
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "HarnessEnvVar": {
      "type": "object",
      "required": ["name", "description"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "HarnessRootDef": {
      "type": "object",
      "required": ["name", "fallback"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "env": {
          "type": "string",
          "minLength": 1
        },
        "use": {
          "type": "string",
          "pattern": "^(?:[^$]|\\$(?!\\{)|\\$\\{[A-Z_][A-Z0-9_]*\\})*$"
        },
        "fallbackEnv": {
          "type": "string",
          "minLength": 1
        },
        "fallback": {
          "type": "string",
          "pattern": "^(?:[^$]|\\$(?!\\{)|\\$\\{[A-Z_][A-Z0-9_]*\\})*$"
        }
      }
    }
  }
}
